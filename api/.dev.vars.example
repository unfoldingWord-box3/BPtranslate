# Copy this file to api/.dev.vars and replace the placeholder. Wrangler
# auto-loads .dev.vars when running `wrangler dev`. NEVER commit the real
# .dev.vars — it's in .gitignore.

# Used to sign / verify Access JWTs minted by /api/auth/dev and /api/auth/dcs.
# Any high-entropy string ≥ 32 chars. In production set with:
#   wrangler secret put JWT_SIGNING_KEY
JWT_SIGNING_KEY=dev-only-replace-with-a-random-32-byte-string

# Optional locally, required for production DCS OAuth sign-in.
# DCS_CLIENT_ID=
# DCS_CLIENT_SECRET=

# Shared service token for the uw-bt-bot AI draft endpoint. Absence
# disables /api/tn-quick (the NoteCard sparkles button greys out with
# "AI generation unavailable"). In production set with:
#   wrangler secret put BT_API_TOKEN
BT_API_TOKEN=

# Wraps org-supplied BYO AI provider API keys before they hit D1 (aiKeyCrypto.ts).
# Base64-encoded 32 random bytes; generate with: openssl rand -base64 32
# In production set with:
#   wrangler secret put AI_KEY_WRAPPING_KEY
# Empty disables the BYO AI key field locally; scripts/worktree-init.sh fills it
# in for worktrees.
AI_KEY_WRAPPING_KEY=

# Local-only super-admin list. "dev" is the username /api/auth/dev mints;
# granting it super-admin here lets local dev-auth switch to any workspace
# (mltest etc.). Deliberately NOT set in wrangler.toml — that block deploys
# to the public dev worker, where a registrable DCS username must not be a
# super-admin. .dev.vars is read only by `wrangler dev`, never deployed.
SUPER_ADMINS=dev
