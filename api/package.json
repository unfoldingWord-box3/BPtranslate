{
  "name": "@bible-editor/api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test \"src/**/*.test.mjs\"",
    "check:ta-refs": "node --experimental-strip-types --no-warnings src/taSupportReferences.check.mjs",
    "check:bot-models": "node --experimental-strip-types --no-warnings src/botModels.check.mjs",
    "deploy": "npm run db:migrate:remote && wrangler deploy --env production",
    "db:migrate:local": "wrangler d1 migrations apply bptranslate_dev --local",
    "db:migrate:remote": "wrangler d1 migrations apply bptranslate --remote --env production",
    "tail": "wrangler tail --env production"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.126.0",
    "hono": "^4.12.23",
    "jose": "^5.9.0",
    "js-yaml": "^4.1.0",
    "usfm-js": "^3.4.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.5.0",
    "wrangler": "^4.90.0"
  }
}
